diff --git a/wasm_memory.go b/wasm_memory.go
new file mode 100644
index 0000000..c0526de
--- /dev/null
+++ b/wasm_memory.go
@@ -0,0 +1,20 @@
+package googlesql
+
+import "fmt"
+
+// wasmMemoryBounds validates a wasm32 address without signed-pointer or
+// pointer-plus-length overflow. Allocation/free APIs retain int32 bit patterns.
+func wasmMemoryBounds(pointer int32, size, memorySize uint64) (uint64, uint64, error) {
+	start := uint64(uint32(pointer))
+	if start > memorySize || size > memorySize-start {
+		return 0, 0, fmt.Errorf("WASM memory range out of bounds: address=%d size=%d memory=%d", start, size, memorySize)
+	}
+	return start, start + size, nil
+}
+func wasmMemorySlice(memory []byte, pointer int32, size uint64) ([]byte, error) {
+	start, end, err := wasmMemoryBounds(pointer, size, uint64(len(memory)))
+	if err != nil {
+		return nil, err
+	}
+	return memory[start:end], nil
+}
diff --git a/wasm_memory_large_test.go b/wasm_memory_large_test.go
new file mode 100644
index 0000000..ef40480
--- /dev/null
+++ b/wasm_memory_large_test.go
@@ -0,0 +1,79 @@
+package googlesql
+
+import (
+	"bytes"
+	wasm2go "github.com/goccy/googlesqlwasm2go"
+	"github.com/goccy/googlesqlwasm2go/base"
+	"os"
+	"testing"
+)
+
+// Opt in explicitly: this test grows real wasm memory beyond 2 GiB. It tests
+// transport addresses, not SQL schemas or application-specific fixture data.
+func TestInvokeAboveSignedWasmAddressBoundary(t *testing.T) {
+	if os.Getenv("GOOGLESQL_LARGE_MEMORY_TEST") != "1" {
+		t.Skip("set GOOGLESQL_LARGE_MEMORY_TEST=1 for the multi-GiB regression")
+	}
+	if err := Init(); err != nil {
+		t.Fatal(err)
+	}
+	m := module()
+	var held []int32
+	defer func() {
+		for _, ptr := range held {
+			wasm2go.WasmFree(m.g, ptr)
+		}
+	}()
+	for i := 0; i < 17; i++ {
+		ptr := wasm2go.WasmAlloc(m.g, 128<<20)
+		if ptr == 0 {
+			t.Fatal("could not reserve test address space")
+		}
+		held = append(held, ptr)
+	}
+	const size = 1 << 20
+	for i := 0; i < 128; i++ {
+		ptr := wasm2go.WasmAlloc(m.g, size)
+		if ptr == 0 {
+			t.Fatal("could not allocate request probe")
+		}
+		if ptr < 0 {
+			wasm2go.WasmFree(m.g, ptr)
+			break
+		}
+		held = append(held, ptr)
+		if i == 127 {
+			t.Fatal("test did not reach the high-address range")
+		}
+	}
+	request := bytes.Repeat([]byte{0x35}, size)
+	response := bytes.Repeat([]byte{0x71}, size)
+	actual, err := m.invoke(0, 0, request, func(g *base.Module, ptr, length int32) (int64, error) {
+		if ptr >= 0 {
+			t.Fatalf("request address did not exercise the signed boundary: %d", ptr)
+		}
+		memory, err := wasmMemorySlice(wasm2go.Memory(g), ptr, uint64(uint32(length)))
+		if err != nil {
+			return 0, err
+		}
+		if !bytes.Equal(memory, request) {
+			t.Fatal("request bytes changed")
+		}
+		out := wasm2go.WasmAlloc(g, size)
+		if out >= 0 {
+			t.Fatalf("response address did not exercise the signed boundary: %d", out)
+		}
+		target, err := wasmMemorySlice(wasm2go.Memory(g), out, size)
+		if err != nil {
+			return 0, err
+		}
+		copy(target, response)
+		return int64(out)<<32 | size, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(actual, response) {
+		t.Fatal("response bytes changed")
+	}
+}
diff --git a/wasm_memory_test.go b/wasm_memory_test.go
new file mode 100644
index 0000000..c0a1e74
--- /dev/null
+++ b/wasm_memory_test.go
@@ -0,0 +1,23 @@
+package googlesql
+
+import "testing"
+
+func TestWasmMemoryBounds(t *testing.T) {
+	for _, tc := range []struct {
+		pointer                 int32
+		size, limit, start, end uint64
+		invalid                 bool
+	}{
+		{16, 4, 64, 16, 20, false}, {-2147415408, 100, 1 << 32, 2147551888, 2147551988, false},
+		{-1, 1, 1 << 32, (1 << 32) - 1, 1 << 32, false}, {-1, 2, 1 << 32, 0, 0, true},
+		{64, 1, 64, 0, 0, true}, {16, ^uint64(0), 64, 0, 0, true}, {0, 0, 0, 0, 0, false},
+	} {
+		a, b, err := wasmMemoryBounds(tc.pointer, tc.size, tc.limit)
+		if (err != nil) != tc.invalid {
+			t.Fatalf("pointer=%d size=%d: unexpected error %v", tc.pointer, tc.size, err)
+		}
+		if err == nil && (a != tc.start || b != tc.end) {
+			t.Fatalf("range=%d:%d expected=%d:%d", a, b, tc.start, tc.end)
+		}
+	}
+}
